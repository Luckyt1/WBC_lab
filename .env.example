# Copy to .env, edit, then: set -a; source .env; set +a
# Use absolute paths. This file is not loaded automatically.
ELF3_ASSET_DIR=/path/to/elf3_bxi_31
ELF3_BXI_FRAMEWORK_DIR=/path/to/bxi_controller_ros2/src/bxi_example_py_elf3
ELF3_MUJOCO_XML=/path/to/bxi_controller_ros2/src/bxi_example_py_elf3/data/mujoco_simulation/elf3.xml
ELF3_IK_SOURCE_DIR=/path/to/elf3-ik-robust/resources/elf3_ik_upstream
ELF3_IK_BANK=/path/to/elf3-ik-robust/resources/ik_bank_v3
ELF3_DEPLOYMENT_PYTHON=/path/to/eval-env/bin/python
ELF3_IK_PYTHON=/path/to/ik-env/bin/python
# Used by the supervisor's AMASS retention evaluation; IK training uses the IK bank.
ELF3_AMASS_DIR=/path/to/retargeted-amass/dataset

# GL-165: uncomment only the paths you need to override.
# Asset default: resources/gl165. IK default: active_ik_bank.json, then ik_bank/.
# GL165_PYTHON=/path/to/isaac-env/bin/python
# GL165_ASSET_DIR=/path/to/gl165
# GL165_IK_BANK=/path/to/gl165/ik_bank_continuous_lateral_v3

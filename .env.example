# deploy.sh loads .env automatically; explicit environment variables take precedence.
# Relative paths are anchored to this checkout. Quote paths containing spaces.
ELF3_TRAIN_PYTHON=.venv-train/bin/python
ELF3_DEPLOYMENT_PYTHON=.venv-eval/bin/python
ELF3_IK_PYTHON=.venv-ik/bin/python
ELF3_ASSET_DIR=resources/elf3_bxi_31
ELF3_BXI_FRAMEWORK_DIR=resources/bxi_example_py_elf3
ELF3_MUJOCO_XML=resources/bxi_example_py_elf3/data/mujoco_simulation/elf3.xml
ELF3_IK_SOURCE_DIR=resources/elf3_ik_upstream
ELF3_IK_BANK=resources/ik_bank_v3
ELF3_AMASS_DIR=resources/dataset
